<!--
  서버 PC 전체 시작: 로봇별 domain_bridge + 관제 서버 (+ 시작 전 위치 맞추기)
    cd ~/ros-repo-2/ros_ws && source install/setup.bash     (경로는 ros_ws 기준)
    export ROS_DOMAIN_ID=50
    ros2 launch src/main_service/launch/system.launch.xml                              # 3대 모두, 운영 설정
    ros2 launch src/main_service/launch/system.launch.xml pinky3:=false                # 준비된 로봇만 (pinky3 안 씀)
    ros2 launch src/main_service/launch/system.launch.xml config:=main_service_test.yaml   # 시험 설정
    ros2 launch src/main_service/launch/system.launch.xml localize:=false              # 위치 맞추기 건너뜀

  pinkyN:=true 인 로봇만 브릿지를 켜고, localize:=true면 서버가 켜진 뒤 그 로봇들에게 이름 순서대로 한 대씩
  위치 맞추기(Control LOCALIZE)를 보낸다: 앞으로 조금 -> 제자리 360° (AMCL) -> 뒤로 -> LOCALIZED -> 다음 로봇.
  위치 맞추기가 끝날 때까지 그 로봇들은 작업을 받지 않는다. 로봇은 먼저 켜 두는 게 좋다 (안 켜져 있으면 최대
  localize_wait_sec 기다렸다가 건너뜀).

  패키지 경로(find-pkg-share)가 아니라 이 파일 경로로 실행한다: 설정 파일 안의 상대 경로(web, node_graph)가
  소스 폴더 기준이라서.
-->
<launch>
  <arg name="pinky1" default="true"/>
  <arg name="pinky2" default="true"/>
  <arg name="pinky3" default="true"/>
  <arg name="localize" default="true"/>   <!-- 시작 전 위치 맞추기 -->
  <arg name="config" default="main_service.yaml"/>   <!-- config/ 안의 파일 이름 (시험: main_service_test.yaml) -->

  <!-- 1. 로봇별 domain_bridge (서버 50 <-> pinky1 51 · pinky2 52 · pinky3 53) -->
  <include file="$(dirname)/../../fleet_msgs/bridge/fleet_bridge.launch.xml">
    <arg name="pinky1" value="$(var pinky1)"/>
    <arg name="pinky2" value="$(var pinky2)"/>
    <arg name="pinky3" value="$(var pinky3)"/>
  </include>

  <!-- 2. 관제 서버. 위치 맞추기 할 로봇 = pinkyN:=true 이고 localize:=true -->
  <node pkg="pinkytorang_main" exec="main_service" name="pinkytorang_main_service" output="screen"
        args="$(dirname)/../config/$(var config) --localize pinky1=$(var pinky1) pinky2=$(var pinky2) pinky3=$(var pinky3) enable=$(var localize)"/>
</launch>
