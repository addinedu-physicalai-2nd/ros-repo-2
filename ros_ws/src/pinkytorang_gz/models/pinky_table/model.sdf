<?xml version="1.0"?>
<!-- 핑키토랑 서빙 테이블: 실제 도면 table1.stl (165 x 110 x 150 mm)
     STL은 뒤집혀 그려져 있음 (z=0 판 = 상판, 기둥 = 다리) -> roll 180도로 바로 세움
     모델 원점 = 바닥 발자국 가운데, 긴 변(165) = 모델 x. 월드에서 yaw 90도로 놓아 긴 변이 map y 방향 -->
<sdf version="1.9">
  <model name="pinky_table">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>-0.0825 0.055 0.150 3.14159265 0 0</pose>
        <geometry>
          <mesh><uri>model://pinky_table/meshes/table1.stl</uri><scale>0.001 0.001 0.001</scale></mesh>
        </geometry>
        <material><ambient>0.97 0.97 0.97 1</ambient><diffuse>0.97 0.97 0.97 1</diffuse></material>
      </visual>
      <collision name="collision">
        <pose>-0.0825 0.055 0.150 3.14159265 0 0</pose>
        <geometry>
          <mesh><uri>model://pinky_table/meshes/table1.stl</uri><scale>0.001 0.001 0.001</scale></mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
